{
  "name": "auxo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "dev:api": "pnpm --filter @auxo/api dev",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "eval:policy": "node apps/api/node_modules/tsx/dist/cli.mjs evals/evaluate-policy.ts"
  }
}
