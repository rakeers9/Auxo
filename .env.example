NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Comma-separated extension origins. Leave empty during local development.
CORS_ORIGINS=

# Use development for the local in-memory stub. Production requires required.
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DECISION_TTL_SECONDS=86400

# Optional Cloudflare Clef integration. Configure both credentials server-side.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLEF_MODEL=clef
DECISION_MODEL_TIMEOUT_MS=2000
