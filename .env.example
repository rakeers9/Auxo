NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Comma-separated extension origins. Leave empty during local development.
CORS_ORIGINS=

# Use development for the local in-memory stub. Production requires required.
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DECISION_TTL_SECONDS=86400

# Optional Jev integration. Leave the key empty to use the local policy/stub path.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
JEV_TIMEOUT_MS=2000
